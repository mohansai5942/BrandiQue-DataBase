rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Public site can display portfolio data; only the trusted server API should write it.
    match /projects/{documentId} {
      allow read: if true;
      allow write: if false;
    }

    match /websites/{documentId} {
      allow read: if true;
      allow write: if false;
    }

    // Public site needs the published contact settings. Server API handles management writes.
    match /settings/{documentId} {
      allow read: if true;
      allow write: if false;
    }

    // Visitors may submit enquiries, but must not read or alter other visitors' submissions.
    match /messages/{documentId} {
      allow create: if request.resource.data.keys().hasAll(['name', 'email', 'message'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 10000;
      allow read, update, delete: if false;
    }

    match /n8n_project_forms/{documentId} {
      allow create: if request.resource.data.keys().hasAll(['name', 'email'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254;
      allow read, update, delete: if false;
    }

    match /n8n_projects/{documentId} {
      allow read: if true;
      allow write: if false;
    }

    // No browser access to prompt records until the public website's usage is audited.
    match /prompts/{documentId} {
      allow read, write: if false;
    }

    // Everything else stays private by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
