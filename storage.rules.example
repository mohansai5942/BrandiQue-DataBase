rules_version = '2';

// BrandiQue Cloud Storage rules for the Data Console's browser uploads.
// The console uploads (as the signed-in admin, via the Firebase client SDK):
//   * project images/videos  -> dashboard/projects/<uuid>-<name>
//   * the login-screen avatar -> dashboard/admin/avatar-<uid>-<name>
// Storage rules cannot read the server's ADMIN_EMAILS variable: replace the placeholder with
// every exact address from the Production ADMIN_EMAILS allowlist (lowercase), then publish in
// Firebase console -> Storage -> Rules.
service firebase.storage {
  match /b/{bucket}/o {
    function signedInAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in ['REPLACE_WITH_EXACT_ADMIN_EMAIL'];
    }

    // Portfolio media is public website content; only a verified admin may upload/replace/delete.
    match /dashboard/projects/{fileName} {
      allow read: if true;
      allow create, update: if signedInAdmin()
        && request.resource.size <= 25 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*') || request.resource.contentType.matches('video/.*'));
      allow delete: if signedInAdmin();
    }

    // Admin avatar shown on the console login screen (public image, admin-only upload, 2 MB max).
    match /dashboard/admin/{fileName} {
      allow read: if true;
      allow create, update: if signedInAdmin()
        && fileName.matches('avatar-' + request.auth.uid + '-.*')
        && request.resource.size <= 2 * 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpeg|webp)');
      allow delete: if signedInAdmin();
    }

    // Everything else is private.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
