# Firebase Web App configuration (public client settings)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=brandique-web-solutions.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=brandique-web-solutions
VITE_FIREBASE_STORAGE_BUCKET=brandique-web-solutions.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=392875307100
VITE_FIREBASE_APP_ID=1:392875307100:web:aef3ff9e70023d9b363699

# Server-only: JSON contents of a Firebase service account for brandique-web-solutions
# Store this in Vercel Environment Variables only; never commit the real value.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Comma-separated exact administrator email addresses allowed to sign in
ADMIN_EMAILS=

# Exact browser origin for this dashboard after deployment, e.g. https://data.brandique.in
DASHBOARD_ORIGIN=

# Optional comma-separated origins allowed to call the API from the public website.
# Keep empty unless cross-origin access is specifically needed.
ALLOWED_ORIGINS=